# Copy to .env.local and adjust.
# Don't put API keys (HF_TOKEN, ORDER_ROUTER_KEY, ...) here - anything prefixed
# with VITE_ ends up in the browser bundle. Those belong in the backend .env.

# Base path the browser calls. "/api" goes through the Vite dev proxy below.
VITE_API_URL=/api

# Where the dev proxy forwards /api to (the Express server).
VITE_BACKEND_ORIGIN=http://localhost:3000

# true = use canned responses from src/api/mock.ts, no backend needed.
VITE_USE_MOCK=true
